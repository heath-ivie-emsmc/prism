{
  "openapi": "3.2.0",
  "info": {
    "title": "Prism API",
    "description": "Revenue cycle metrics for ambulance and fire Providers. Every route needs a signed-in session. Responses are aggregate-only unless a route says otherwise.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost"
    }
  ],
  "paths": {
    "/up": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Liveness",
        "description": "Returns 200 while the process is running. It never touches the database.",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/ready": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Readiness",
        "description": "Returns 200 when Prism\u0027s database accepts connections, otherwise 503 with no detail. The check is shared and cached for 5 seconds.",
        "responses": {
          "200": {
            "description": "OK"
          },
          "503": {
            "description": "Service Unavailable"
          }
        }
      }
    },
    "/api/v1/me": {
      "get": {
        "tags": [
          "Identity"
        ],
        "summary": "The signed-in user",
        "description": "Returns the user, the Providers they may see (with how many Facilities each is limited to) and their permissions. Returns 401 when there is no valid session.",
        "operationId": "GetMe",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "MeResponse": {
        "required": [
          "userName",
          "displayName",
          "providers",
          "permissions"
        ],
        "type": "object",
        "properties": {
          "userName": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          },
          "providers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProviderResponse"
            }
          },
          "permissions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "description": "Response of \u0060GET /api/me\u0060."
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "ProviderResponse": {
        "required": [
          "id",
          "name",
          "facilityCount"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "facilityCount": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          }
        },
        "description": "A Provider the user may see. FacilityCount is how many Facilities they are limited to, and 0 means all of them. The Facility ids stay on the server."
      }
    }
  },
  "tags": [
    {
      "name": "Health"
    },
    {
      "name": "Identity"
    }
  ]
}
