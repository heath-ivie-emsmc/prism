{
  "name": "web",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "build:api": "ng build && node scripts/copy-to-api.mjs",
    "lint": "eslint \"src/**/*.{ts,html}\"",
    "test:ci": "ng test --watch=false --coverage",
    "e2e": "playwright test",
    "e2e:layout": "playwright test e2e/layout.spec.ts"
  },
  "private": true,
  "packageManager": "npm@12.2.3",
  "dependencies": {
    "@angular/cdk": "^22.3.0",
    "@angular/common": "^22.3.0",
    "@angular/compiler": "^22.3.0",
    "@angular/core": "^22.3.0",
    "@angular/forms": "^22.3.0",
    "@angular/material": "^22.3.0",
    "@angular/platform-browser": "^22.3.0",
    "@angular/router": "^22.3.0",
    "@ems-management-consultants/ui": "^0.1.0",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "echarts": "^6.1.0",
    "material-symbols": "^0.27.2",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.3.0",
    "@angular/cli": "^22.3.0",
    "@angular/compiler-cli": "^22.3.0",
    "@playwright/test": "^1.65.1",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.1.1",
    "angular-eslint": "^22.8.0",
    "axe-core": "^4.14.1",
    "eslint": "^9.39.5",
    "jsdom": "^31.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "@ems-management-consultants/ui": {
      "@angular/core": "$@angular/core",
      "@angular/common": "$@angular/common",
      "@angular/forms": "$@angular/forms",
      "@angular/router": "$@angular/router",
      "@angular/cdk": "$@angular/cdk",
      "@angular/material": "$@angular/material"
    }
  }
}
