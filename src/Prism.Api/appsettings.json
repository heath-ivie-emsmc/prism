{
  "AllowedHosts": "*",
  "Auth": {
    "ApplicationId": "",
    "AccountPortalBaseUrl": "",
    "AdminPortalApiBaseUrl": "",
    "LoginTokenIssuer": "",
    "AdminPortalAudience": "",
    "LoginTokenPublicKeyUrl": "",
    "LoginTokenPublicKeyCacheSeconds": 0,
    "SessionLifetimeMinutes": 480,
    "AllowIdpInitiated": false,
    "PostLoginRedirectUrl": "/"
  },
  "Aws": {
    "SecretsLoader": {
      "Enabled": false
    }
  },
  "FeatureManagement": {
    "Enabled": false
  },
  "FeatureFlags": {},
  "Warehouse": {
    "MaxPoolSize": 20,
    "CommandTimeoutSeconds": 30,
    "MaxRows": 10000
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "System.Net.Http.HttpClient": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  }
}
